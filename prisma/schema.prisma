generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// PLAN & SUBSCRIPTION (Membership)
// =====================================================

enum PlanName {
  TRIAL
  STARTER
  BISNIS
  PRO
  ENTERPRISE
}

enum SubStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Plan {
  id           String   @id @default(cuid())
  name         PlanName @unique
  maxAnggota   Int      // -1 = unlimited
  maxLokasi    Int
  hargaBulanan Decimal  @db.Decimal(10, 2) @default(0)
  hargaTahunan Decimal  @db.Decimal(10, 2) @default(0)
  // { whatsapp, telegram, export, faceRec, laporan, multiLokasi }
  fitur        Json
  tenants      Tenant[]
  createdAt    DateTime @default(now())

  @@map("plans")
}

model Subscription {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status        SubStatus @default(TRIAL)
  mulai         DateTime  @default(now())
  berakhir      DateTime
  refPembayaran String?
  catatan       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("subscriptions")
}

// =====================================================
// TENANT (Organisasi)
// =====================================================

enum TenantType {
  SEKOLAH
  PERUSAHAAN
}

model Tenant {
  id           String         @id @default(cuid())
  nama         String
  slug         String         @unique
  type         TenantType     @default(PERUSAHAAN)
  logoUrl      String?
  alamat       String?
  telepon      String?
  isDemo       Boolean        @default(false)
  demoExpiresAt DateTime?
  planId       String
  plan         Plan           @relation(fields: [planId], references: [id])
  subscription Subscription?
  members      TenantMember[]
  departemen   Departemen[]
  lokasi       Lokasi[]
  jamAbsensi   JamAbsensi[]
  absensi      Absensi[]
  izin         Izin[]
  invites      Invite[]
  pengumuman   Pengumuman[]
  gaji         Gaji[]
  jatahCuti    JatahCuti[]
  lembur       Lembur[]
  mutasi       Mutasi[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("tenants")
}

// =====================================================
// USER & TENANT MEMBER
// =====================================================

enum Role {
  SUPER_ADMIN   // Platform owner
  TENANT_ADMIN  // Kepala sekolah / HRD / pemilik bisnis
  ANGGOTA       // Guru / karyawan
  WALI          // Orang tua (khusus SEKOLAH)
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum Agama {
  ISLAM
  KRISTEN
  KATOLIK
  HINDU
  BUDDHA
  KONGHUCU
}

enum TipeKaryawan {
  TETAP
  KONTRAK
  MAGANG
  PARTIME
  FREELANCE
}

enum StatusPajak {
  TK0   // Tidak Kawin, 0 tanggungan  PTKP 54jt
  TK1   // Tidak Kawin, 1 tanggungan  PTKP 58.5jt
  TK2   // Tidak Kawin, 2 tanggungan  PTKP 63jt
  TK3   // Tidak Kawin, 3 tanggungan  PTKP 67.5jt
  K0    // Kawin, 0 tanggungan        PTKP 58.5jt
  K1    // Kawin, 1 tanggungan        PTKP 63jt
  K2    // Kawin, 2 tanggungan        PTKP 67.5jt
  K3    // Kawin, 3 tanggungan        PTKP 72jt
}

// User = identitas global dari SSO Z One — tidak ada password
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  nama         String
  avatarUrl    String?
  isSuperAdmin Boolean        @default(false)
  memberships  TenantMember[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("users")
}

// TenantMember = User yang bergabung ke Tenant tertentu
model TenantMember {
  id            String        @id @default(cuid())
  userId        String
  tenantId      String
  role          Role          @default(ANGGOTA)
  jabatan       String?
  nip           String?       // NIP / NIK / ID karyawan internal
  noHp          String?
  faceEmbedding Json?         // face-api.js descriptor vector
  aktif         Boolean       @default(true)

  // === Data Pribadi ===
  nik           String?       // NIK KTP 16 digit
  tempatLahir   String?
  tanggalLahir  DateTime?
  jenisKelamin  JenisKelamin?
  agama         Agama?
  golDarah      String?       // A / B / AB / O

  // === Alamat ===
  alamat        String?
  kota          String?
  provinsi      String?
  kodePos       String?

  // === Kontrak Kerja ===
  departemenId  String?
  tipeKaryawan  TipeKaryawan  @default(TETAP)
  tanggalMulai  DateTime?
  tanggalAkhir  DateTime?

  // === Penggajian ===
  gajiPokok        Float?
  statusPajak      StatusPajak   @default(TK0)
  tunjanganJabatan Float         @default(0)
  tunjanganMakan   Float         @default(0)  // per hari hadir
  tunjanganTransport Float       @default(0)  // per hari hadir
  namaBank      String?
  noRekening    String?
  atasNamaRek   String?
  npwp          String?

  // === Kontak Darurat (JSON: [{nama, hubungan, noHp}]) ===
  kontakDarurat Json?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departemen    Departemen?   @relation(fields: [departemenId], references: [id])
  absensi       Absensi[]
  izin          Izin[]
  izinApprover  Izin[]        @relation("Approver")
  gaji          Gaji[]
  jatahCuti     JatahCuti[]
  lembur        Lembur[]
  mutasi        Mutasi[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId, aktif])
  @@map("tenant_members")
}

// Departemen / Divisi dalam sebuah Tenant
model Departemen {
  id        String         @id @default(cuid())
  tenantId  String
  nama      String
  deskripsi String?
  aktif     Boolean        @default(true)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   TenantMember[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId])
  @@map("departemen")
}

// Invite link untuk mengundang anggota
model Invite {
  id        String    @id @default(cuid())
  tenantId  String
  email     String?   // null = siapa saja bisa pakai link ini
  token     String    @unique @default(cuid())
  role      Role      @default(ANGGOTA)
  jabatan   String?
  usedAt    DateTime?
  expiredAt DateTime
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@map("invites")
}

// =====================================================
// LOKASI & GEOFENCING
// =====================================================

model Lokasi {
  id        String    @id @default(cuid())
  tenantId  String
  nama      String    // "Kantor Pusat", "Cabang Bandung"
  alamat    String?
  lat       Float
  lng       Float
  radius    Int       @default(100) // meter
  aktif     Boolean   @default(true)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  absensi   Absensi[]
  createdAt DateTime  @default(now())

  @@map("lokasi")
}

// =====================================================
// JAM ABSENSI / SHIFT
// =====================================================

model JamAbsensi {
  id          String   @id @default(cuid())
  tenantId    String
  nama        String   // "Shift Pagi", "Full Day", "WFH"
  hari        String   // "SENIN,SELASA,RABU,KAMIS,JUMAT"
  jamMasuk    String   // "08:00"
  jamKeluar   String   // "17:00"
  toleransi   Int      @default(15)
  aktif       Boolean  @default(true)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  absensi     Absensi[]
  createdAt   DateTime @default(now())

  @@map("jam_absensi")
}

// =====================================================
// ABSENSI
// =====================================================

enum StatusAbsensi {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPHA
}

model Absensi {
  id            String        @id @default(cuid())
  tenantId      String
  memberId      String
  lokasiId      String?
  jamAbsensiId  String?
  tanggal       DateTime      @db.Date
  waktuMasuk    DateTime?
  waktuKeluar   DateTime?
  status        StatusAbsensi @default(HADIR)
  latMasuk      Float?
  lngMasuk      Float?
  latKeluar     Float?
  lngKeluar     Float?
  fotoMasuk     String?
  fotoKeluar    String?
  keterangan    String?
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member        TenantMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lokasi        Lokasi?       @relation(fields: [lokasiId], references: [id])
  jamAbsensi    JamAbsensi?   @relation(fields: [jamAbsensiId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([memberId, tanggal])
  @@index([tenantId, tanggal])
  @@map("absensi")
}

// =====================================================
// IZIN / CUTI
// =====================================================

enum JenisIzin {
  IZIN
  SAKIT
  CUTI_TAHUNAN
  CUTI_SAKIT
  DINAS_LUAR
}

enum StatusIzin {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

model Izin {
  id              String     @id @default(cuid())
  tenantId        String
  memberId        String
  jenis           JenisIzin
  tanggalMulai    DateTime   @db.Date
  tanggalSelesai  DateTime   @db.Date
  alasan          String
  lampiranUrl     String?
  status          StatusIzin @default(MENUNGGU)
  approverId      String?
  catatanApprover String?
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member          TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  approver        TenantMember? @relation("Approver", fields: [approverId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tenantId, status])
  @@map("izin")
}

// Kuota cuti per karyawan per tahun per jenis
model JatahCuti {
  id        String       @id @default(cuid())
  tenantId  String
  memberId  String
  tahun     Int
  jenis     JenisIzin
  jatah     Int          @default(12) // total hari alokasi
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([memberId, tahun, jenis])
  @@index([tenantId, tahun])
  @@map("jatah_cuti")
}

// =====================================================
// GAJI / INSENTIF
// =====================================================

model Gaji {
  id                String   @id @default(cuid())
  tenantId          String
  memberId          String
  bulan             Int
  tahun             Int

  // Kehadiran
  jumlahHadir       Int      @default(0)
  jumlahTerlambat   Int      @default(0)
  jumlahAlpha       Int      @default(0)
  jumlahIzin        Int      @default(0)
  jumlahHariKerja   Int      @default(0)   // total hari kerja dalam bulan

  // Penghasilan
  gajiPokok         Float    @default(0)
  tunjanganJabatan  Float    @default(0)
  tunjanganHadir    Float    @default(0)   // tunjangan makan+transport per hadir
  tunjanganLainnya  Json?                  // [{nama, nominal}]
  lemburJam         Int      @default(0)
  lemburNominal     Float    @default(0)
  gajiKotor         Float    @default(0)   // sum semua penghasilan

  // Potongan kehadiran
  potonganAlpha     Float    @default(0)
  potonganTerlambat Float    @default(0)

  // Potongan wajib
  bpjsKes           Float    @default(0)   // 1% gajiPokok (karyawan)
  bpjsTK            Float    @default(0)   // 3% gajiPokok (JHT 2% + JP 1%)
  pph21             Float    @default(0)   // PPh 21 bulanan
  potonganLainnya   Json?                  // [{nama, nominal}]

  // Hasil akhir
  totalPotongan     Float    @default(0)
  takehomePay       Float    @default(0)   // gajiKotor - totalPotongan
  totalGaji         Float    @default(0)   // alias takehomePay (backward compat)

  catatan           String?
  dibayarkan        Boolean  @default(false)
  tanggalBayar      DateTime?

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member            TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([memberId, bulan, tahun])
  @@index([tenantId, bulan, tahun])
  @@map("gaji")
}

// =====================================================
// LEMBUR
// =====================================================

enum StatusLembur {
  MENUNGGU
  DISETUJUI
  DITOLAK
}

model Lembur {
  id              String       @id @default(cuid())
  tenantId        String
  memberId        String
  tanggal         DateTime     @db.Date
  jamLembur       Float        @default(0)
  keterangan      String?
  status          StatusLembur @default(MENUNGGU)
  approvedById    String?      // memberId approver (no FK to avoid Prisma ambiguity)
  tanggalApproval DateTime?
  catatanApproval String?
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member          TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId, memberId, tanggal])
  @@index([tenantId, status])
  @@map("lembur")
}

// =====================================================
// MUTASI (Riwayat Perubahan Karyawan)
// =====================================================

enum JenisMutasi {
  PINDAH_DEPARTEMEN
  PERUBAHAN_JABATAN
  PERUBAHAN_TIPE
  KENAIKAN_GAJI
  PENURUNAN_GAJI
  KONTRAK_BARU
  LAINNYA
}

model Mutasi {
  id         String      @id @default(cuid())
  tenantId   String
  memberId   String
  tanggal    DateTime    @default(now())
  jenis      JenisMutasi @default(LAINNYA)
  sebelum    Json
  sesudah    Json
  keterangan String?
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     TenantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@index([tenantId, memberId])
  @@map("mutasi")
}

// =====================================================
// PENGUMUMAN
// =====================================================

model Pengumuman {
  id        String   @id @default(cuid())
  tenantId  String
  judul     String
  isi       String
  aktif     Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("pengumuman")
}

// =====================================================
// LOG NOTIFIKASI
// =====================================================

model NotifikasiLog {
  id        String   @id @default(cuid())
  tenantId  String?
  memberId  String?
  jenis     String
  pesan     String
  noTujuan  String
  berhasil  Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("notifikasi_log")
}
